[Desktop Entry]
Type=Application
Version=1.5
Name=Tokkip Phone
GenericName=Phone Link
Comment=Connect your Android phone and Linux PC over LAN
Exec=tokkiphone-desktop %U
Icon=tokkiphone
Terminal=false
Categories=Network;FileTransfer;Telephony;
Keywords=android;phone;sync;clipboard;notifications;files;mirror;sms;calls;
StartupNotify=true
StartupWMClass=tokkiphone
MimeType=x-scheme-handler/tokkiphone;x-scheme-handler/tel;x-scheme-handler/sms;x-scheme-handler/smsto;x-scheme-handler/mms;x-scheme-handler/mmsto;x-scheme-handler/geo;
Actions=send-files;send-clipboard;find-phone;take-photo;open-timeline;

[Desktop Action send-files]
Name=Send files to phone
Exec=tokkiphone-desktop --task send-files

[Desktop Action send-clipboard]
Name=Send clipboard to phone
Exec=tokkiphone-desktop --task send-clipboard

[Desktop Action find-phone]
Name=Find my phone
Exec=tokkiphone-desktop --task find-phone

[Desktop Action take-photo]
Name=Take photo with phone
Exec=tokkiphone-desktop --task take-photo

[Desktop Action open-timeline]
Name=Open Timeline
Exec=tokkiphone-desktop --task open-timeline
